{
  "name": "@unabandoned/amf",
  "version": "0.0.7",
  "description": "Action Message Format (AMF0/3)",
  "main": "dist/index.js",
  "module": "dist.esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "dist.esm",
    "src",
    "!src/**/*.test.ts"
  ],
  "keywords": [
    "actionscript",
    "rtmp",
    "amf",
    "flash",
    "adobe"
  ],
  "scripts": {
    "clean": "node -e \"for (const d of ['dist', 'dist.esm', 'build-test']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "test": "tsc -p tsconfig.test.json && node --test \"build-test/**/*.test.js\"",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unabandoned/amf.git"
  },
  "bugs": {
    "url": "https://github.com/unabandoned/amf/issues"
  },
  "homepage": "https://github.com/unabandoned/amf#readme",
  "author": "Astronaut Labs, LLC",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@astronautlabs/bitstream": "^4.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "22.20.5",
    "reflect-metadata": "0.2.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@astronautlabs/bitstream": {
      "reflect-metadata": "$reflect-metadata"
    }
  }
}
